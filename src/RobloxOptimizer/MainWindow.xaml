<Window x:Class="RobloxOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Optimizer" Height="640" Width="480"
        MinHeight="560" MinWidth="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="14"
        Background="#FF13151A"
        UseLayoutRounding="True">
    <Window.Resources>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#FF13151A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FF1C1F26"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FF2A2E38"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF1F2F4"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9AA1AE"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF7C5CFF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF9380FF"/>
        <SolidColorBrush x:Key="GoodBrush" Color="#FF3DD68C"/>
        <SolidColorBrush x:Key="MutedButtonBrush" Color="#FF262A33"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="RoundButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonBase}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonBase}">
            <Setter Property="Background" Value="{StaticResource MutedButtonBrush}"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#9889;" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Roblox Optimizer" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource MutedButtonBrush}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                <TextBlock x:Name="RobloxStatusText" Text="Roblox: checking..." FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <TabControl Grid.Row="1">

            <!-- ===================== Optimize tab ===================== -->
            <TabItem Header="Optimize">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Live status" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock x:Name="CpuText" Text="CPU: checking..." Margin="0,0,0,6"/>
                                <TextBlock x:Name="RamText" Text="RAM: checking..." Margin="0,0,0,6"/>
                                <TextBlock x:Name="PingText" Text="Ping: checking..."
                                           ToolTip="Latency to a public Internet server - a general connection check, not your exact Roblox server ping."
                                           AutomationProperties.HelpText="Latency to a public Internet server - a general connection check, not your exact Roblox server ping."/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button x:Name="OptimizeButton" Content="&#9889; _Optimize for Roblox" Style="{StaticResource PrimaryButtonStyle}"
                                    FontSize="15" Click="OptimizeButton_Click" Margin="0,0,10,0" IsDefault="True"
                                    ToolTip="Switches to a high-performance power plan, turns off the Xbox Game Bar overlay, and (if Roblox is open) sets it to use your dedicated GPU and slightly raises its priority. All of this is undoable and none of it needs administrator permission."
                                    AutomationProperties.Name="Optimize for Roblox"
                                    AutomationProperties.HelpText="Switches to a high-performance power plan, turns off the Xbox Game Bar overlay, and if Roblox is open sets it to use your dedicated GPU and slightly raises its priority. Undoable. Does not need administrator permission. Keyboard shortcut: Alt+O."/>
                            <Button x:Name="UndoButton" Content="&#8617; _Undo Changes" Style="{StaticResource SecondaryButtonStyle}"
                                    FontSize="15" Click="UndoButton_Click" IsEnabled="False"
                                    ToolTip="Puts every setting Optimize changed back to what it was before."
                                    AutomationProperties.Name="Undo Changes"
                                    AutomationProperties.HelpText="Puts every setting Optimize changed back to what it was before. Keyboard shortcut: Alt+U."/>
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Activity log" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ScrollViewer x:Name="LogScrollViewer" MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="LogText" TextWrapping="Wrap" Text="Ready."
                                               Style="{StaticResource SecondaryTextStyle}"
                                               AutomationProperties.Name="Activity log"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Voice Effects tab ===================== -->
            <TabItem Header="Voice Effects">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="&#127908; For fun only" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
                                    Record a few seconds of your mic, then play it back with a fun effect through your
                                    speakers/headphones. This does not impersonate any real person's voice, and it
                                    doesn't feed into Roblox's voice chat - actually routing a changed voice into a
                                    game requires installing a separate virtual audio cable app, which isn't included
                                    here. See the tip at the bottom of this tab if you want to set that up yourself.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button x:Name="RecordButton" Content="&#127908; _Record 5 Seconds" Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="15" HorizontalAlignment="Left" Margin="0,0,0,14" Click="RecordButton_Click"
                                ToolTip="Records 5 seconds from your default microphone."
                                AutomationProperties.Name="Record 5 seconds"
                                AutomationProperties.HelpText="Records 5 seconds from your default microphone. Keyboard shortcut: Alt+R."/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Play back as..." FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <UniformGrid Columns="2" Rows="2">
                                    <Button x:Name="PlayNormalButton" Content="&#9654; Normal" Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,8" IsEnabled="False" Click="PlayNormalButton_Click"/>
                                    <Button x:Name="PlayDeepButton" Content="&#127911; Deep Voice" Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,0,8" IsEnabled="False" Click="PlayDeepButton_Click"/>
                                    <Button x:Name="PlayHighButton" Content="&#128522; High Voice" Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,8,8,0" IsEnabled="False" Click="PlayHighButton_Click"/>
                                    <Button x:Name="PlayRobotButton" Content="&#129302; Robot" Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,8,0,0" IsEnabled="False" Click="PlayRobotButton_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <TextBlock x:Name="VoiceStatusText" Text="Ready to record."
                                       Style="{StaticResource SecondaryTextStyle}"
                                       AutomationProperties.Name="Voice effects status"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="&#128266; Live Voice Changer" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10">
                                    Continuously processes your mic while running, instead of record-then-play. To
                                    actually use it inside Roblox voice chat automatically, install a free virtual
                                    audio cable app yourself (e.g. VB-CABLE), pick it as the output device below, then
                                    select that same cable as your microphone in Roblox's voice settings. Otherwise,
                                    pick your normal speakers/headphones below to just hear the effect on yourself.
                                </TextBlock>

                                <TextBlock Text="Effect" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="LiveNormalRadio" Content="Normal" GroupName="LiveEffect" IsChecked="True" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="LiveDeepRadio" Content="Deep" GroupName="LiveEffect" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="LiveHighRadio" Content="High" GroupName="LiveEffect" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="LiveRobotRadio" Content="Robot" GroupName="LiveEffect"/>
                                </StackPanel>

                                <TextBlock Text="Output device" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="LiveOutputDeviceCombo" Grid.Column="0" Margin="0,0,8,0"
                                              AutomationProperties.Name="Live voice changer output device"/>
                                    <Button x:Name="RefreshDevicesButton" Grid.Column="1" Content="&#8635;" Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6" Click="RefreshDevicesButton_Click"
                                            ToolTip="Refresh the list of output devices (e.g. after installing a virtual audio cable app)."
                                            AutomationProperties.Name="Refresh output devices"/>
                                </Grid>

                                <Button x:Name="LiveToggleButton" Content="&#9654; _Start Live Voice Changer" Style="{StaticResource PrimaryButtonStyle}"
                                        FontSize="15" HorizontalAlignment="Left" Click="LiveToggleButton_Click"
                                        ToolTip="Continuously applies the selected effect to your microphone and sends it to the chosen output device, until you stop it."
                                        AutomationProperties.Name="Start or stop the live voice changer"
                                        AutomationProperties.HelpText="Continuously applies the selected effect to your microphone and sends it to the chosen output device, until you stop it. Keyboard shortcut: Alt+S."/>

                                <TextBlock x:Name="LiveStatusText" Text="Live voice changer is off." Margin="0,10,0,0"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           AutomationProperties.Name="Live voice changer status"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" FontSize="12">
                            Tip: to use a changed voice inside Roblox (or Discord) voice chat, install a virtual audio
                            cable app (e.g. VB-CABLE), set your changed-voice output to play into it, then pick that
                            cable as your microphone inside Roblox's voice settings. This app doesn't install or
                            bundle anything like that for you.
                        </TextBlock>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
