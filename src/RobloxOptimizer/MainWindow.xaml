<Window x:Class="RobloxOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Optimizer" Height="540" Width="440"
        MinHeight="480" MinWidth="380"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}"
        UseLayoutRounding="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Roblox Optimizer" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"
                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
        <TextBlock Grid.Row="1" Text="One button to make Roblox run smoother - everything it changes can be undone."
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <!--
            No AutomationProperties.LiveSetting here on purpose: CPU/RAM/ping refresh every 2 seconds,
            and a live region would make a screen reader re-announce all of it constantly. Only the
            activity log below (which changes on meaningful events, not continuously) is a live region.
        -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,12"
                AutomationProperties.Name="Status">
            <StackPanel>
                <TextBlock x:Name="RobloxStatusText" Text="Roblox: checking..." Margin="0,0,0,6" FontWeight="SemiBold"/>
                <TextBlock x:Name="CpuText" Text="CPU: checking..." Margin="0,0,0,4"/>
                <TextBlock x:Name="RamText" Text="RAM: checking..." Margin="0,0,0,4"/>
                <TextBlock x:Name="PingText" Text="Ping: checking..."
                           ToolTip="Latency to a public Internet server - a general connection check, not your exact Roblox server ping."
                           AutomationProperties.HelpText="Latency to a public Internet server - a general connection check, not your exact Roblox server ping."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="OptimizeButton" Content="_Optimize for Roblox" Padding="18,12" FontSize="15" FontWeight="Bold"
                    Click="OptimizeButton_Click" Margin="0,0,8,0" Cursor="Hand" IsDefault="True"
                    ToolTip="Switches to a high-performance power plan, turns off the Xbox Game Bar overlay, and (if Roblox is open) sets it to use your dedicated GPU and slightly raises its priority. All of this is undoable and none of it needs administrator permission."
                    AutomationProperties.Name="Optimize for Roblox"
                    AutomationProperties.HelpText="Switches to a high-performance power plan, turns off the Xbox Game Bar overlay, and if Roblox is open sets it to use your dedicated GPU and slightly raises its priority. Undoable. Does not need administrator permission. Keyboard shortcut: Alt+O."/>
            <Button x:Name="UndoButton" Content="_Undo Changes" Padding="18,12" FontSize="15" Cursor="Hand"
                    Click="UndoButton_Click" IsEnabled="False"
                    ToolTip="Puts every setting Optimize changed back to what it was before."
                    AutomationProperties.Name="Undo Changes"
                    AutomationProperties.HelpText="Puts every setting Optimize changed back to what it was before. Keyboard shortcut: Alt+U."/>
        </StackPanel>

        <Border Grid.Row="4" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1"
                CornerRadius="6" Padding="10">
            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" TextWrapping="Wrap" Text="Ready."
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           AutomationProperties.Name="Activity log"
                           AutomationProperties.LiveSetting="Polite"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
