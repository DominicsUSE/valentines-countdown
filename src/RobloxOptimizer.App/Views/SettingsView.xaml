<UserControl x:Class="RobloxOptimizer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,16,4,4">

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Beginner / Advanced mode" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8">
                        Beginner mode keeps the numbers simple. Advanced mode (toggle in the top-right corner) shows the same real measurements with more
                        technical detail and tooltips - RPO never shows different, less accurate data in either mode.
                    </TextBlock>
                    <ToggleButton IsChecked="{Binding IsAdvancedMode}" Content="Advanced mode" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Restore everything" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8">
                        Reverts every setting RPO has changed (power plan, overlays, GPU preference, process priority) back to what it was before RPO touched it.
                        Startup app and background app choices are not affected - undo those individually from the Optimize tab.
                    </TextBlock>
                    <Button Style="{StaticResource DangerButtonStyle}" Content="Restore Defaults" Command="{Binding UndoChangesCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Safety and privacy" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap">
                        - Never collects passwords, Roblox credentials, browsing history, or private files.
                        <LineBreak/>
                        - No ads, cryptocurrency mining, telemetry, or bundled software of any kind.
                        <LineBreak/>
                        - All settings, backups, and the audit log are stored locally under %LOCALAPPDATA%\RobloxOptimizer\ - nothing is transmitted anywhere.
                        <LineBreak/>
                        - Administrator permission is requested only for the specific actions that genuinely require it (see the Optimize tab), never for the whole app.
                        <LineBreak/>
                        - Never disables antivirus software, Windows security services, Windows Update, or the firewall.
                        <LineBreak/>
                        - Does not promise "zero ping," a guaranteed FPS number, or results your hardware/ISP can't actually deliver.
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap">
                        Roblox Performance Optimizer helps reduce avoidable FPS drops, stuttering, and network lag by adjusting legitimate, documented Windows,
                        Roblox-related, and network settings. It cannot exceed your hardware's limits or reduce Internet latency below what your connection and
                        physical distance to a server allow.
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
