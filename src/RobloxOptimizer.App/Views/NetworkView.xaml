<UserControl x:Class="RobloxOptimizer.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,16,4,4">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Run Network Test" Command="{Binding RunNetworkTestCommand}" Margin="0,0,8,0"
                        ToolTip="Sends a series of pings to measure current/average latency, jitter, and packet loss, and checks Wi-Fi signal if applicable."/>
                <Button Content="Flush DNS Cache" Command="{Binding FlushDnsCommand}"
                        ToolTip="Clears Windows' local DNS cache. This is a troubleshooting step for stale DNS records - it normally does NOT reduce in-game ping, since Roblox connects to game servers by IP, not by re-resolving DNS every match."/>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Connection" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}">
                        <Run Text="Type:"/><Run Text="{Binding ConnectionTypeDisplay, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Visibility="{Binding IsWifi, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Run Text="Wi-Fi signal:"/><Run Text="{Binding WifiSignalDisplay, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Recommendation: use a wired Ethernet connection when one is available - it is typically more stable than Wi-Fi."
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Latency" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}">
                        <Run Text="Current ping:"/><Run Text="{Binding PingCurrentDisplay, Mode=OneWay}"/>
                        <LineBreak/>
                        <Run Text="Average ping:"/><Run Text="{Binding PingAverageDisplay, Mode=OneWay}"/>
                        <LineBreak/>
                        <Run Text="Jitter:"/><Run Text="{Binding JitterDisplay, Mode=OneWay}"/>
                        <LineBreak/>
                        <Run Text="Packet loss:"/><Run Text="{Binding PacketLossDisplay, Mode=OneWay}"/>
                        <LineBreak/>
                        <Run Text="Download activity:"/><Run Text="{Binding DownloadDisplay, Mode=OneWay}"/>
                        <LineBreak/>
                        <Run Text="Upload activity:"/><Run Text="{Binding UploadDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Regional comparison (general Internet route quality - not Roblox server ping)"
                               Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold"
                               ToolTip="RPO cannot discover which physical server a Roblox session is matched to. These pings measure general route quality to well-known public Internet endpoints only."/>
                    <ItemsControl ItemsSource="{Binding NetworkSnapshot.RegionalPings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding EndpointName}" Style="{StaticResource SecondaryTextStyle}"
                                               ToolTip="{Binding ApproximateRegion}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LatencyMs, Converter={StaticResource MeasurementToStringConverter}, ConverterParameter=' ms'}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Bandwidth and router guidance" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
                        Large downloads, cloud sync, and video streaming on your network compete for the same bandwidth as Roblox. If your router supports
                        Quality of Service (QoS), you can usually prioritize your gaming PC's traffic from the router's own admin page - RPO cannot configure
                        your router directly, since every router's interface is different.
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
