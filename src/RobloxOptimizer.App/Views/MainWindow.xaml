<Window x:Class="RobloxOptimizer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RobloxOptimizer.App.Views"
        Title="Roblox Performance Optimizer"
        Height="820" Width="1180" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Roblox Performance Optimizer" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RobloxStatusDisplay}" Style="{StaticResource SecondaryTextStyle}"
                               ToolTip="Whether RobloxPlayerBeta.exe is currently detected as running."/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Advanced mode" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ToggleButton IsChecked="{Binding IsAdvancedMode}" Content="Beginner / Advanced"
                              ToolTip="Beginner mode hides technical detail. Advanced mode shows raw numbers and more tooltips."/>
            </StackPanel>
        </Grid>

        <!-- Main tabs -->
        <TabControl Grid.Row="1">
            <TabItem Header="Dashboard">
                <views:DashboardView/>
            </TabItem>
            <TabItem Header="Network">
                <views:NetworkView/>
            </TabItem>
            <TabItem Header="Optimize">
                <views:OptimizeView/>
            </TabItem>
            <TabItem Header="Recommendations">
                <views:RecommendationsView/>
            </TabItem>
            <TabItem Header="Roblox">
                <views:RobloxView/>
            </TabItem>
            <TabItem Header="Logs">
                <views:LogsView/>
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView/>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}"/>
        </Border>
    </Grid>
</Window>
