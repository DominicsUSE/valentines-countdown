<UserControl x:Class="RobloxOptimizer.App.Views.RobloxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,16,4,4">

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Detection" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RobloxStatusDisplay}"/>
                    <TextBlock Text="RPO detects RobloxPlayerBeta.exe by name only - it never reads Roblox's memory, edits its files, or automates input into the game."
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Roblox's own Performance Stats" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold"/>
                    <TextBlock Text="While playing, press Shift+F5 to toggle Roblox's built-in Performance Stats overlay. It shows Roblox's own authoritative FPS, ping, and memory numbers - use it to double-check anything RPO reports."
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Maximum FPS" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
                        Prioritizes frame rate over visuals. In Roblox: Settings -&gt; Graphics Quality -&gt; drag all the way down, or turn off Automatic and pick a low fixed level.
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Balanced" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
                        A middle ground. In Roblox: leave Graphics Quality on Automatic, or set a mid fixed level (around 5-7).
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Visual Quality" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
                        Keeps visuals high; only safe background/overlay cleanup is applied. In Roblox: set Graphics Quality to a high fixed level or Automatic if your system can sustain it.
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="What RPO will never do to Roblox" Style="{StaticResource MetricLabelStyle}" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap">
                        RPO never modifies Roblox's installed files, client settings, or FastFlags (documented or undocumented), never touches anti-cheat components or game memory,
                        and never automates mouse/keyboard input into the game. Performance also varies a lot between different Roblox experiences and the specific server you're
                        matched to - identical hardware and network conditions can still run very differently between places.
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
