<UserControl x:Class="RobloxOptimizer.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4,16,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Refresh" Command="{Binding RefreshAuditLogCommand}" Margin="0,0,8,0"/>
            <TextBlock Text="Local audit log of every setting RPO has changed. Stored under %LOCALAPPDATA%\RobloxOptimizer\audit.log - never transmitted anywhere."
                       Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0">
            <ListView ItemsSource="{Binding AuditLogEntries}" Background="Transparent" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time (UTC)" Width="160" DisplayMemberBinding="{Binding TimestampUtc}"/>
                        <GridViewColumn Header="Action" Width="200" DisplayMemberBinding="{Binding ActionId}"/>
                        <GridViewColumn Header="Description" Width="320" DisplayMemberBinding="{Binding Description}"/>
                        <GridViewColumn Header="Success" Width="70" DisplayMemberBinding="{Binding Success}"/>
                        <GridViewColumn Header="Elevated" Width="70" DisplayMemberBinding="{Binding RanElevated}"/>
                        <GridViewColumn Header="Error" Width="200" DisplayMemberBinding="{Binding ErrorMessage}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
